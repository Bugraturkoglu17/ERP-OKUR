# Runtime secrets: Northflank backend AND worker. Never commit real values.
ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-OKUR-ENDPOINT.neon.tech/okur_erp?sslmode=require
OKUR_PRODUCTION_DB_HOST=YOUR-OKUR-ENDPOINT.neon.tech
SECRET_KEY=CHANGE_ME_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
REDIS_URL=redis://REDIS_INTERNAL_HOST:6379/0
AUTO_MIGRATE=false
AUTO_CREATE_SCHEMA=false
AUTO_SEED_LOCAL_DATA=false
AUTO_BOOTSTRAP_PLATFORM_ADMIN=false
FRONTEND_URL=https://YOUR-FRONTEND.code.run
CORS_ORIGINS=["https://YOUR-FRONTEND.code.run"]
OCI_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OCI_BUCKET_NAME=okur-erp-files
OCI_REGION=auto
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET
EMAIL_PROVIDER=disabled
EMAIL_ASYNC_ENABLED=false
EMAIL_FROM_NAME_DEFAULT=OKUR ERP
VAPID_SUBJECT=mailto:bahadirsarman@gmail.com

# Frontend BUILD arguments, not backend variables:
# NEXT_PUBLIC_API_URL=/api/v1
# API_INTERNAL_URL=http://BACKEND_INTERNAL_HOST:8000
# NEXT_PUBLIC_HIDE_BRAND=false
