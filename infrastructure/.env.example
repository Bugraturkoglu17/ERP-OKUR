# Database
POSTGRES_DB=okur_erp_local
POSTGRES_USER=okur_local
POSTGRES_PASSWORD=<değiştirin_üretimde>

# Redis
REDIS_PASSWORD=<değiştirin>

# pgAdmin
PGADMIN_EMAIL=admin@okur.local
PGADMIN_PASSWORD=<değiştirin>

# JWT Auth
SECRET_KEY=<jwt_icin_min_32_karakter_anahtari_olusturun>
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Oracle Cloud (OCI / S3-compatible Object Storage)
OCI_BUCKET_NAME=okur-local
OCI_NAMESPACE=your-tenancy-namespace
OCI_REGION=eu-frankfurt-1
AWS_ACCESS_KEY_ID=<oci_access_key_id>
AWS_SECRET_ACCESS_KEY=<oci_secret_access_key>

# Celery
CELERY_WORKERS=4
CELERY_WORKER_POOL=prefork

# Runtime
ENV=development

# DB / Cache URLs (opsiyonel override)
# DATABASE_URL=postgresql+psycopg2://sismik_admin:<db_sifre>@db:5432/sismik_erp
# REDIS_URL=redis://:<redis_sifre>@redis:6379/0

# Bootstrap / Migration
AUTO_MIGRATE=true
AUTO_MIGRATE_WAIT_SECONDS=90
AUTO_BOOTSTRAP_PLATFORM_ADMIN=false

# Geliştirici Admin Bootstrap (opsiyonel)
PLATFORM_ADMIN_EMAIL=admin@okur.local
PLATFORM_ADMIN_PASSWORD=<min_10_karakter>
PLATFORM_ADMIN_FULL_NAME=Geliştirici Admin
# Geriye dönük alias'lar
# ADMIN_EMAIL=admin@okur.local
# ADMIN_PASSWORD=<min_10_karakter>

# Email / Resend
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM_DEFAULT=noreply@okur.local
EMAIL_FROM_NAME_DEFAULT=OKUR
EMAIL_REPLY_TO_DEFAULT=noreply@okur.local

# Bildirim davranışı
EMAIL_ASYNC_ENABLED=false
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_DELAY_SECONDS=60
